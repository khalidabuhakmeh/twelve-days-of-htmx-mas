@model ViewModels.CardDetails

<article class="advent">
    <div class="advent-number" aria-hidden="true">#@Model.Number</div>
    <img src="@Url.Content(@Model.ImageUrl)" alt="Screenshot of the sample for day @Model.Number: @Model.Title" loading="lazy" width="640" height="400"/>
    <div class="advent-body">
        <h3>@Model.Title</h3>
        <p>@Model.Description</p>
        <a asp-page="@Model.Page" class="advent-link">Learn Now<span class="visually-hidden"> about day @Model.Number: @Model.Title</span></a>
    </div>
</article>
