@model PagingModel

@{
    var nextDay = $"/Samples/Day_{Model.NextDay:00}/Index";
    var previousDay = $"/Samples/Day_{Model.PreviousDay:00}/Index";
}

<nav aria-label="next and previous days">
    <ul class="ornaments">
        @if (Model.HasPreviousDay)
        {
            <li><a asp-page="@previousDay">Previous</a></li>
        }
        else
        {
            <li><a asp-page="/Index">Home</a></li>
        }
        @if (Model.HasNextDay)
        {
            <li><a asp-page="@nextDay">Next</a></li>
        }
        else
        {
            <li><a asp-page="/Index">Home</a></li>
        }
    </ul>
</nav>
