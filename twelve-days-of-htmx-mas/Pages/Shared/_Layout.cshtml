@using Htmx.TagHelpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - 12 Days of Htmx-mas</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mountains+of+Christmas:wght@400;700&family=Nunito:wght@400;600;800&display=swap"/>
    <meta name="color-scheme" content="light dark"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.1/dist/htmx.min.js"></script>
    <meta name="htmx-config" includeAspNetAntiforgeryToken="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
    <div class="container">
        <a class="brand" asp-area="" asp-page="/Index"><span class="brand-mark" aria-hidden="true">🎅</span> 12 Days of Htmx-mas</a>
        <nav aria-label="Main">
            <ul class="site-nav">
                <li><a asp-area="" asp-page="/Index">All 12 days</a></li>
            </ul>
        </nav>
    </div>
</header>
<div class="garland" aria-hidden="true"></div>
<main id="main">
    <div class="container">
        @RenderBody()
    </div>
</main>

<footer class="site-footer">
    <div class="container">
        <p>Made with 🎄 and Htmx. &copy; @DateTime.Now.Year Khalid Abuhakmeh</p>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    // htmx 4 ignores unknown keys (antiForgery) in the htmx-config meta, so copy it onto htmx.config
    // before the antiforgery script reads it.
    (function () {
        var m = document.querySelector('meta[name="htmx-config"]');
        if (!m || !window.htmx) return;
        try { htmx.config.antiForgery = JSON.parse(m.content).antiForgery; } catch (e) { }
    })();
</script>
@Html.HtmxAntiforgeryScript()
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>