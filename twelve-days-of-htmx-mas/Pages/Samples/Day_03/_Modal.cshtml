@using System.Globalization
<dialog id="myModal" class="modal text-center" aria-labelledby="myModalTitle">
    <div class="modal-header">
        <h2 id="myModalTitle" class="modal-title">Opening the present...</h2>
        <form method="dialog">
            <button class="modal-close" aria-label="Close">&#10005;</button>
        </form>
    </div>
    <div class="modal-body">
        <h2 class="text-center">You got a GameDude!</h2>
        <img src="~/img/gameboy.svg" alt="handheld game console" width="400" height="400"/>
        <p class="fw-bold">Remember this moment: @DateTime.Now.ToString(CultureInfo.InvariantCulture)</p>
    </div>
    <div class="modal-footer">
        <form method="dialog">
            <button class="btn btn-danger">Close</button>
        </form>
    </div>
    <script>
    showModal("myModal");
    </script>
</dialog>
