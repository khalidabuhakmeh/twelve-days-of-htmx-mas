@model IndexModel

<table id="people" class="table">
    <thead class="bg-danger text-white">
    <tr hx-target:inherited="#people" hx-swap:inherited="outerHTML">
        <th tabindex="0" hx-trigger="click, keyup[key=='Enter'], keyup[key==' ']" hx-get hxn-page="Index" hxn-route-SortBy="Id" scope="col" role="button" style="width: 80px;">
            @if (Model.SortBy == nameof(Person.Id)) { <span>❄︎</span> }
            #
        </th>
        <th tabindex="0" hx-trigger="click, keyup[key=='Enter'], keyup[key==' ']" hx-get hxn-page="Index" hxn-route-SortBy="Name" scope="col" role="button" style="width: 180px;">
            @if (Model.SortBy == nameof(Person.Name)) { <span>❄︎</span> }
            Name
        </th>
        <th tabindex="0" hx-trigger="click, keyup[key=='Enter'], keyup[key==' ']" hx-get hxn-page="Index" hxn-route-SortBy="Behavior" scope="col" role="button">
            @if (Model.SortBy == nameof(Person.Behavior)) { <span>❄︎</span> }
            Behavior
        </th>
    </tr>
    </thead>
    <tbody>
    @foreach (var person in Model.People)
    {
        <tr>
            <td>@person.Id</td>
            <td>@person.Name</td>
            <td>@person.Behavior</td>
        </tr>
    }
    </tbody>
</table>